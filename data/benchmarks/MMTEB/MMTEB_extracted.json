  "step4_assessments": {
    "assessments": {
      "Bitext Mining Datasets": {
        "translated": {"value": "mixed", "evidence": "Mix of parallel text from human translations (Flores, NTREX) and found parallel text (Tatoeba, NorwegianCourts). Machine-translated datasets filtered out of MTEB(Multilingual).", "confidence": "high"},
        "native_annotators": {"value": "mixed", "evidence": "Annotation types: expert-annotated and human-annotated. Native speaker status not tracked.", "confidence": "medium"},
        "culturally_grounded": {"value": false, "evidence": "Bitext mining evaluates parallel text alignment, not cultural knowledge.", "confidence": "high"},
        "annotation_quality_notes": "Quality ensured via MMTEB review process with sanity checks."
      },
      "Classification Datasets": {
        "translated": {"value": "mixed", "evidence": "Many natively authored (AfriSenti, news classifications) but MassiveIntent/Scenario are 'human-translated and localized' from English.", "confidence": "high"},
        "native_annotators": {"value": "mixed", "evidence": "Varies: derived, human-annotated, expert-annotated across datasets.", "confidence": "medium"},
        "culturally_grounded": {"value": "partially", "evidence": "Native news/sentiment datasets are culturally grounded; translated datasets inherit English patterns.", "confidence": "medium"},
        "annotation_quality_notes": "43 tasks in MTEB(Multilingual). Performance validated with sanity checks."
      },
      "Clustering Datasets": {
        "translated": {"value": "mixed", "evidence": "SIB200 flagged for English label transfer. WikiClustering uses native Wikipedia. English-only ArXiv/Biorxiv are not translated.", "confidence": "high"},
        "native_annotators": {"value": "mostly_no", "evidence": "Most use derived annotations from data structure. SIB200 labels from English.", "confidence": "high"},
        "culturally_grounded": {"value": "partially", "evidence": "WikiClustering uses native categories. SIB200 inherits English topics.", "confidence": "medium"},
        "annotation_quality_notes": "17 tasks. Clustering reformulated with bootstrapping (16.11x speedup)."
      },
      "Retrieval Datasets": {
        "translated": {"value": "mixed", "evidence": "MIRACL, CovidRetrieval are native. WikipediaRetrieval uses native content with LLM-generated queries. Some English-only.", "confidence": "high"},
        "native_annotators": {"value": "mixed", "evidence": "Expert-annotated (MIRACL, Belebele), human-annotated (MLQA), LM-generated (Wikipedia).", "confidence": "medium"},
        "culturally_grounded": {"value": "partially", "evidence": "Wikipedia and MIRACL use native content. Many English-domain-specific.", "confidence": "medium"},
        "annotation_quality_notes": "18 tasks. Downsampled with TREC pooling (250 docs/query)."
      },
      "STS Datasets": {
        "translated": {"value": "mixed", "evidence": "English STS12-17 original. STSBenchmark machine-translated. FaroeseSTS, FinParaSTS, JSICK, IndicCrosslingualSTS are native.", "confidence": "high"},
        "native_annotators": {"value": "mostly_yes", "evidence": "Most human-annotated or expert-annotated.", "confidence": "medium"},
        "culturally_grounded": {"value": "partially", "evidence": "Language-specific datasets use local content. English benchmarks reflect Western web/news.", "confidence": "medium"},
        "annotation_quality_notes": "16 tasks. Primary metric: Spearman correlation."
      },
      "Instruction Retrieval Datasets": {
        "translated": {"value": false, "evidence": "All 3 tasks English-only from TREC.", "confidence": "high"},
        "native_annotators": {"value": true, "evidence": "Professional TREC assessors.", "confidence": "high"},
        "culturally_grounded": {"value": false, "evidence": "English-only news retrieval.", "confidence": "high"},
        "annotation_quality_notes": "3 datasets. New task type. Excluded from per-category averages."
      }
    }
  },
